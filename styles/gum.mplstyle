# Clean, journal-like matplotlib style. Use: plt.style.use('<toolkit>/styles/gum.mplstyle')
font.family: sans-serif
font.sans-serif: Geist, Inter, DejaVu Sans
font.size: 11
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
axes.edgecolor: 333740
axes.labelcolor: 16171B
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 10
axes.grid: True
grid.alpha: 0.25
grid.linewidth: 0.6
axes.prop_cycle: cycler('color', ['2C46D6', '8A8F9C', 'E2764F', '1F8A5B'])
lines.linewidth: 1.8
lines.markersize: 5
errorbar.capsize: 2
xtick.color: 333740
ytick.color: 333740
legend.frameon: False
figure.figsize: 6.4, 4.2
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
mathtext.fontset: cm
